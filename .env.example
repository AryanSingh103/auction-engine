# Copy to .env (git-ignored) and adjust. Every variable is required.
# Format rules: plain KEY=value, no quotes, no spaces around '=', no inline
# comments. The same file is read by the Makefile (`include`, which would keep
# quotes literally), by docker compose, and by `docker run --env-file`.
# Never put a real credential in this file: it is committed to a public repo.

# --- API process ---
# Listen address. Use :8080 (all interfaces). "localhost:8080" works on the
# host but makes the server unreachable from outside its container.
HTTP_ADDR=:8080
# debug, info, warn or error
LOG_LEVEL=info
# Go duration: how long graceful shutdown waits for in-flight requests.
SHUTDOWN_TIMEOUT=15s

# --- docker compose ---
# Host port the API container is published on.
APP_HOST_PORT=8080
# Local development Postgres. Not used by the API until milestone 1.
POSTGRES_USER=auction
POSTGRES_PASSWORD=auction-local-dev
POSTGRES_DB=auction
POSTGRES_HOST_PORT=5432
