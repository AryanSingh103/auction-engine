# Copy to .env (git-ignored) and adjust. Every variable is required.
# Format rules: plain KEY=value, no quotes, no spaces around '=', no inline
# comments, and no '$' in values (both the shell and compose would expand it).
# The same file is sourced by `make run` and interpolated by docker compose.
# Never put a real credential in this file: it is committed to a public repo.

# --- API process ---
# Listen address for `make run` on the host. In docker compose the API
# container always listens on :8080 (set in compose.yaml).
HTTP_ADDR=:8080
# Separate listener for Prometheus /metrics; never exposed publicly. In
# docker compose the API container always uses :9091 (set in compose.yaml).
METRICS_ADDR=:9091
# debug, info, warn or error
LOG_LEVEL=info
# Go duration: budget for the whole graceful shutdown (API drain, metrics
# server, live handlers).
# Must stay below stop_grace_period in compose.yaml (20s) and, in M6, the ECS
# task stopTimeout; otherwise the process is SIGKILLed mid-drain.
SHUTDOWN_TIMEOUT=15s
# HTTP server timeouts (Go durations, all > 0). See docs/decisions/003.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
# Keep above the AWS ALB idle timeout (60s default) to avoid 502s from
# the server closing a keep-alive connection the ALB is about to reuse.
HTTP_IDLE_TIMEOUT=75s
# Deadline on every request's context. Must be less than HTTP_WRITE_TIMEOUT.
REQUEST_TIMEOUT=5s
# Postgres for `make run` / `make migrate` on the host. Must match the
# POSTGRES_* values below; compose builds its own in-network URL from those.
DATABASE_URL=postgres://auction:auction-local-dev@127.0.0.1:5432/auction?sslmode=disable
# Max pooled connections per API process.
DB_MAX_CONNS=20
# Redis for `make run` on the host; compose uses its own in-network URL.
REDIS_URL=redis://127.0.0.1:6379/0
# Per-operation Redis timeout. Redis is an accelerator: on timeout the API
# degrades (reads Postgres, allows the request) rather than failing.
REDIS_TIMEOUT=200ms
# Longest a cached auction state can be served stale if a post-commit cache
# refresh was lost (normally the cache is refreshed on every accepted bid).
AUCTION_CACHE_TTL=10s
# Live WebSocket updates (docs/decisions/020): per-connection buffer before
# a slow client is dropped, keepalive ping (keep well under the ALB's 60s
# idle timeout), per-write timeout, and how often rooms get the current head
# (bounds staleness if a pub/sub message is lost).
WS_SEND_BUFFER=64
# Cap on concurrent live connections per API instance (503 beyond it).
WS_MAX_CONNECTIONS=1000
WS_PING_INTERVAL=20s
WS_WRITE_TIMEOUT=5s
WS_SYNC_INTERVAL=5s
# Per-user bid rate limit (token bucket in Redis): BURST bids at once,
# refilled at BIDS_PER_SECOND. scripts/bench.sh raises these for load runs.
RATE_LIMIT_BIDS_PER_SECOND=10
RATE_LIMIT_BID_BURST=20
# Bid concurrency strategy: pessimistic (production) or optimistic
# (benchmarking only; see docs/decisions/014).
BID_LOCKING=pessimistic
# Postgres ends a session idle inside a transaction for this long, releasing
# its locks (e.g. if an API host dies mid-bid). Far above the milliseconds
# between a bid's statements.
DB_IDLE_IN_TX_TIMEOUT=5s

# --- outbox relay (cmd/relay, docs/decisions/022) ---
# Kafka for processes run on the host; compose uses redpanda:9092.
KAFKA_BROKERS=127.0.0.1:19092
OUTBOX_TOPIC=auction-events
# Only used when the relay creates the topic; an existing topic is never
# repartitioned (that would move keys and break per-auction order).
OUTBOX_TOPIC_PARTITIONS=6
# 1 locally (one broker); 3 in any real cluster.
KAFKA_REPLICATION_FACTOR=1
# Most events per publish transaction, and the wait after a batch that
# was not full.
RELAY_BATCH_SIZE=100
RELAY_POLL_INTERVAL=100ms
# Wait for Kafka acknowledgements per batch. Must be below
# DB_IDLE_IN_TX_TIMEOUT: the batch's transaction stays open meanwhile.
RELAY_PUBLISH_TIMEOUT=3s

# --- fake payment provider (cmd/paysim, docs/decisions/023) ---
# The brief's flakiness: 10% of charges fail (half of them AFTER charging,
# a lost response) and a few hang for 5s after charging. 0 disables each.
PAYSIM_FAILURE_RATE=0.1
PAYSIM_HANG_RATE=0.02
PAYSIM_HANG_DURATION=5s

# --- settlement (cmd/settler, docs/decisions/024) ---
SETTLEMENT_GROUP=settlement
SETTLEMENT_DLQ_TOPIC=settlement-dlq
# Wait before retrying an event after a database error.
SETTLEMENT_RETRY_INTERVAL=1s
# Per payment attempt; well under PAYSIM_HANG_DURATION, so a hang becomes a
# quick retry (same idempotency key) instead of a stalled settlement.
PAYMENT_TIMEOUT=2s
# Attempts per invoice per delivery before dead-lettering (the invoice
# stays pending: a lost response may have charged), with full-jitter
# backoff from BASE up to CAP between them.
PAYMENT_MAX_ATTEMPTS=6
PAYMENT_BACKOFF_BASE=100ms
PAYMENT_BACKOFF_CAP=5s
# Open the breaker after this many consecutive unknown outcomes, for this long.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_DURATION=10s

# --- docker compose ---
# Host port the API container is published on.
APP_HOST_PORT=8080
# Host port of the second API instance (api2).
APP2_HOST_PORT=8081
# Local development Postgres. Keep the password URL-safe (letters, digits,
# '-'): compose splices it into a connection URL.
POSTGRES_USER=auction
POSTGRES_PASSWORD=auction-local-dev
POSTGRES_DB=auction
POSTGRES_HOST_PORT=5432

REDIS_HOST_PORT=6379
# Host port for Kafka clients outside compose (the broker advertises
# 127.0.0.1 on this port to them).
REDPANDA_HOST_PORT=19092

# --- observability (docker compose) ---
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
# Local-only admin login for editing dashboards; viewing needs no login.
GRAFANA_ADMIN_PASSWORD=local-dev-grafana
