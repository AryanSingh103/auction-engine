      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(bids_total[1m])) > 0",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
