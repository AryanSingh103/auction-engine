# Local environment. Holds real values; .env.example is the committed template.
.env

# Build output
/bin/

# Test and coverage artifacts
coverage.out
*.test

# OS and editor files
.DS_Store
.vscode/

# Terraform: state holds resource IDs and can hold secrets; tfvars hold
# per-environment values. Neither is ever committed. The provider lock file
# (.terraform.lock.hcl) IS committed so provider versions are pinned.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
